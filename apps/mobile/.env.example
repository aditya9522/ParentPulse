# Public client-side key. Restrict it to your Android/iOS app IDs and required Maps APIs.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=replace_me

# Public API endpoint; use your computer's LAN IP for a physical Android device.
# Android emulator alternative: http://10.0.2.2:8000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1

# Public web origin that renders a doctor brief for an expiring share token.
EXPO_PUBLIC_SHARE_BASE_URL=https://parentpulse.example/share/brief
