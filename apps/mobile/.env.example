# Public OAuth client IDs used by native Google Credential Manager / Google Sign-In.
# Create Web, Android, and iOS OAuth clients in the same Google Cloud project.
# The Android client must register package com.parentpulse.app and every EAS/Play SHA-1.
# Store these EXPO_PUBLIC values in the matching EAS environment; they are public app configuration.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=replace_me.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=replace_me.apps.googleusercontent.com

# Public API endpoint; use your computer's LAN IP for a physical Android device.
# Android emulator alternative: http://10.0.2.2:8000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1

# Optional MapLibre-compatible HTTPS style. The app defaults to OpenFreeMap Liberty.
# For production traffic, configure a provider or self-hosted style with capacity appropriate for your users.
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Public web origin that renders a doctor brief for an expiring share token.
EXPO_PUBLIC_SHARE_BASE_URL=https://parentpulse-yjnj.onrender.com/api/v1/sharing/doctor-brief
